# Which strategies run in this single deploy (coordinator included if wanted)
STRATEGIES=coordinator,dca,lp

# Shared by every strategy
BASE_RPC_URL=https://mainnet.base.org
OPENROUTER_API_KEY=
PAPER_TRADING=true
DRY_RUN=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Per strategy: AGENT_<ID>_<VAR> becomes <VAR> for that strategy only.
# A global PRIVATE_KEY is ignored on purpose: each strategy signs with its own wallet.
AGENT_DCA_PRIVATE_KEY=
AGENT_LP_PRIVATE_KEY=
# AGENT_PERP_SYNFUTURES_PRIVATE_KEY=
# AGENT_DCA_TRADING_INTERVAL=3600
# Telegram commands need a dedicated bot per strategy (one token = one listener)
# AGENT_LP_TELEGRAM_BOT_TOKEN=

# "Apri Dashboard" links use the VPS IP (resolved from the domain); override if wrong
# PUBLIC_HOST=203.0.113.10
# Or a full URL per agent (expose the port in docker-compose.yml)
# AGENT_DCA_PUBLIC_URL=http://your-host:3005

# Coordinator
MASTER_PRIVATE_KEY=
